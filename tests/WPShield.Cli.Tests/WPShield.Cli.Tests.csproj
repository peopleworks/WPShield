<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Matches the project under test, which is Windows-only by nature. -->
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/WPShield.Cli/WPShield.Cli.csproj" />
  </ItemGroup>
  <!-- The network filter's fake driver, shared by link with WPShield.NetworkFilter.Tests. -->
  <ItemGroup>
    <Compile Include="../WPShield.NetworkFilter.Tests/Support/*.cs" Link="NetworkFilter/Support/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
