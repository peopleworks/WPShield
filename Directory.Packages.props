<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Web.Administration" Version="11.1.0" />
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Spectre.Console" Version="0.49.1" />
    <PackageVersion Include="QuestPDF" Version="2024.12.3" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <!--
      SharpPcap and PacketDotNet are Windows-only packet capture dependencies. They are declared
      here for central version management but are referenced only by WPShield.NetworkSensor. The
      four platform-independent projects (Abstractions, Core, Rules.Windows, Rules.WordPress) do
      not reference them, so the Linux CI leg is unaffected.
    -->
    <PackageVersion Include="SharpPcap" Version="4.1.0" />
    <PackageVersion Include="PacketDotNet" Version="1.4.9-pre53" />
  </ItemGroup>
</Project>