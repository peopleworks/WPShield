<UserControl x:Class="WPShield.Desktop.CommandCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded" IsVisibleChanged="OnVisibilityChanged">
  <UserControl.Resources>
    <DataTemplate x:Key="CommandMetric">
      <Grid Margin="0,2" ToolTip="{Binding Help}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" MaxWidth="190"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" Foreground="#365463" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"
                   ToolTip="{Binding Label}" FontSize="12"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <Viewbox Width="43" Height="13" Margin="0,0,5,0" Stretch="Fill">
            <Viewbox.Style>
              <Style TargetType="Viewbox">
                <Style.Triggers><DataTrigger Binding="{Binding Trend}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
              </Style>
            </Viewbox.Style>
            <Canvas Width="100" Height="18"><Path Data="{Binding Trend}" Stroke="#396A78" StrokeThickness="2"/></Canvas>
          </Viewbox>
          <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="SemiBold" MaxWidth="185" TextTrimming="CharacterEllipsis">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#152C3D"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Tone}" Value="Grey"><Setter Property="Foreground" Value="#556975"/></DataTrigger>
                  <DataTrigger Binding="{Binding Tone}" Value="Green"><Setter Property="Foreground" Value="#15684E"/></DataTrigger>
                  <DataTrigger Binding="{Binding Tone}" Value="Red"><Setter Property="Foreground" Value="#A1272C"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Grid>
    </DataTemplate>
    <Style x:Key="CommandTile" TargetType="Button">
      <Setter Property="Foreground" Value="#152C3D"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#CFDCE2"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Card" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#307975"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#307975"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="Grey"><Setter Property="Background" Value="#F2F5F7"/></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Green"><Setter Property="BorderBrush" Value="#56A78E"/></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Red">
          <Setter Property="Background" Value="#FFF1F1"/><Setter Property="BorderBrush" Value="#B33A3A"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,8,10">
      <Button x:Name="RefreshButton" DockPanel.Dock="Right" Click="OnRefresh" VerticalAlignment="Center"
              Background="#145856" Foreground="White" BorderThickness="0" Padding="15,8" FontWeight="SemiBold"/>
      <StackPanel>
        <TextBlock x:Name="Heading" FontSize="30" FontWeight="SemiBold"/>
        <TextBlock x:Name="ReadingTime" Foreground="#486475" FontSize="12"/>
      </StackPanel>
    </DockPanel>
    <Border x:Name="ProblemBox" DockPanel.Dock="Top" Background="#FFF4DF" BorderBrush="#E9C27A" BorderThickness="1"
            CornerRadius="7" Padding="10,8" Margin="0,0,8,8" Visibility="Collapsed">
      <TextBlock x:Name="Problem" TextWrapping="Wrap" Foreground="#5E3F0B"/>
    </Border>
    <ScrollViewer x:Name="DashboardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="OnDashboardSize">
      <ItemsControl x:Name="Tiles" Tag="280">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Width="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Margin="0,0,8,8"
                    Style="{StaticResource CommandTile}" Click="OnTile" AutomationProperties.Name="{Binding Title}">
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" Margin="0,4,0,5" FontSize="12"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" Foreground="#476170"/>
                <ItemsControl ItemsSource="{Binding Metrics}" ItemTemplate="{StaticResource CommandMetric}"/>
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay, TargetNullValue=0}" Height="6" Margin="0,7,0,0"
                             AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Metrics[0].Tooltip}">
                  <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                      <Setter Property="Foreground" Value="#396A78"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Tone}" Value="Grey"><Setter Property="Foreground" Value="#8496A0"/></DataTrigger>
                        <DataTrigger Binding="{Binding Progress}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ProgressBar.Style>
                </ProgressBar>
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
