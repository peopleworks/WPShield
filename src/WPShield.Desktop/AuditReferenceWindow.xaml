<Window x:Class="WPShield.Desktop.AuditReferenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WPShield"
        Width="830" Height="580" MinWidth="570" MinHeight="450" WindowStartupLocation="CenterOwner"
        Background="#EFF3F6" Foreground="#152C3D" FontFamily="Segoe UI" FontSize="14" Closed="OnClosed">
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Copy" CanExecute="CanCopy" Executed="CopyReference"/>
  </Window.CommandBindings>
  <Grid Margin="22,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel>
      <Button x:Name="OpenButton" DockPanel.Dock="Right" VerticalAlignment="Center" Background="#145856"
              Foreground="White" BorderThickness="0" Padding="15,8" Click="OpenFile"/>
      <StackPanel><TextBlock Text="WPShield" FontSize="12" Foreground="#486475"/>
        <TextBlock x:Name="Heading" FontSize="28" FontWeight="SemiBold"/></StackPanel>
    </DockPanel>
    <TextBlock x:Name="CoverageLabel" Grid.Row="1" Margin="0,12" Foreground="#365463" TextWrapping="Wrap"/>
    <ListView x:Name="Entries" Grid.Row="2" SelectionMode="Single" Background="White" BorderBrush="#CFDCE2"
              SelectionChanged="SelectReference" ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <ListView.View><GridView>
        <GridViewColumn x:Name="SourceColumn" Width="100" DisplayMemberBinding="{Binding Source}"/>
        <GridViewColumn x:Name="IdColumn" Width="185" DisplayMemberBinding="{Binding Id}"/>
        <GridViewColumn x:Name="TimeColumn" Width="230" DisplayMemberBinding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss.fff}'}"/>
      </GridView></ListView.View>
    </ListView>
    <Border Grid.Row="3" Background="White" BorderBrush="#CFDCE2" BorderThickness="1" CornerRadius="6" Margin="0,12,0,0" Padding="12">
      <DockPanel>
        <Button x:Name="CopyButton" DockPanel.Dock="Right" Command="ApplicationCommands.Copy" Margin="12,0,0,0" Padding="10,6" VerticalAlignment="Center"/>
        <StackPanel><TextBlock x:Name="PreviewLabel" FontWeight="SemiBold"/>
          <TextBlock x:Name="Preview" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,4,0,0"/></StackPanel>
      </DockPanel>
    </Border>
    <TextBlock Grid.Row="4" x:Name="Status" Margin="0,8,0,0" Foreground="#365463" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  </Grid>
</Window>
