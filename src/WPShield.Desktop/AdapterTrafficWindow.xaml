<Window x:Class="WPShield.Desktop.AdapterTrafficWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WPShield"
        Width="880" Height="550" MinWidth="650" MinHeight="435" WindowStartupLocation="CenterOwner"
        Background="#EFF3F6" Foreground="#152C3D" FontFamily="Segoe UI" FontSize="14"
        Loaded="LoadAdapters" Closed="OnClosed">
  <Grid Margin="22,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="WPShield  /  Windows" Foreground="#486475" FontSize="12"/>
      <TextBlock x:Name="Heading" FontSize="30" FontWeight="SemiBold"/></StackPanel>
    <DockPanel Grid.Row="1" Margin="0,12,0,10">
      <Button DockPanel.Dock="Right" x:Name="Reload" Padding="10,4" Click="LoadAdapters" Margin="8,0,0,0"/>
      <Label x:Name="AdapterLabel" Target="{Binding ElementName=Adapters}" Padding="0,4,10,4"/>
      <ComboBox x:Name="Adapters" DisplayMemberPath="Name" SelectionChanged="ChangeAdapter"
                ToolTip="{Binding SelectedItem.Id, RelativeSource={RelativeSource Self}}"/>
    </DockPanel>
    <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,10">
      <Border Background="#D9EFEB" CornerRadius="8" Padding="14,9" Margin="0,0,4,0">
        <StackPanel><TextBlock x:Name="ReceiveLabel" Foreground="#105F59"/><TextBlock x:Name="ReceiveRate" FontWeight="SemiBold" FontSize="25" Text="—"/></StackPanel>
      </Border>
      <Border Background="#E4EAF6" CornerRadius="8" Padding="14,9" Margin="4,0,0,0">
        <StackPanel><TextBlock x:Name="SendLabel" Foreground="#384F87"/><TextBlock x:Name="SendRate" FontWeight="SemiBold" FontSize="25" Text="—"/></StackPanel>
      </Border>
    </UniformGrid>
    <Border Grid.Row="3" Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#CFDCE2" Padding="14">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel><CheckBox DockPanel.Dock="Right" x:Name="Pause" Checked="ChangePause" Unchecked="ChangePause"/>
          <TextBlock x:Name="Scale" FontWeight="SemiBold"/></DockPanel>
        <Grid Grid.Row="1" Margin="0,12,0,4">
          <Border Background="#E6ECEF" Height="1" VerticalAlignment="Top"/>
          <Border Background="#E6ECEF" Height="1" VerticalAlignment="Center"/>
          <Border Background="#C9D8DF" Height="1" VerticalAlignment="Bottom"/>
          <UniformGrid x:Name="Plot" Columns="30" Rows="1" SizeChanged="ResizePlot"/>
        </Grid>
        <DockPanel Grid.Row="2"><TextBlock x:Name="GapLabel" DockPanel.Dock="Right" FontSize="12" Foreground="#89561A"/>
          <TextBlock x:Name="RangeLabel" FontSize="12" Foreground="#486475"/></DockPanel>
      </Grid>
    </Border>
    <TextBlock Grid.Row="4" x:Name="Status" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#365463"/>
  </Grid>
</Window>
