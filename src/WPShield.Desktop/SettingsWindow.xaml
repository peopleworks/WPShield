<Window x:Class="WPShield.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WPShield"
        Width="1180" Height="800" MinWidth="900" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="#EFF3F6" Foreground="#152C3D" FontFamily="Segoe UI" FontSize="14"
        Loaded="OnLoaded" Closed="OnClosed">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#CFDCE2"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="16,11"/>
    </Style>
    <Style x:Key="Small" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#476170"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Fact" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#486475"/>
      <Setter Property="Margin" Value="0,3,14,3"/>
    </Style>
    <Style x:Key="FactValue" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Action" TargetType="Button">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#E8EEF1"/>
      <Setter Property="Foreground" Value="#324F5F"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="CellText" TargetType="TextBlock">
      <Setter Property="Margin" Value="8,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Style>
  </Window.Resources>
  <Grid Margin="22,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <DockPanel>
      <Button x:Name="RefreshButton" DockPanel.Dock="Right" VerticalAlignment="Center" Click="OnRefresh" Background="#145856"
              Foreground="White" BorderThickness="0" Padding="15,8" FontWeight="SemiBold"/>
      <StackPanel>
        <TextBlock x:Name="SourceLabel" Foreground="#486475" FontSize="12"/>
        <TextBlock x:Name="Heading" FontSize="30" FontWeight="SemiBold"/>
        <TextBlock x:Name="Subtitle" Style="{StaticResource Small}"/>
      </StackPanel>
    </DockPanel>

    <Border x:Name="Banner" Grid.Row="1" Margin="0,12,0,0" Background="#FFF4DF" BorderBrush="#E9C27A" BorderThickness="1"
            CornerRadius="8" Padding="14,10" Visibility="Collapsed">
      <DockPanel>
        <Button x:Name="ElevateButton" DockPanel.Dock="Right" Click="OnElevate" Padding="12,6" Margin="12,0,0,0"
                Background="#8A5A12" Foreground="White" BorderThickness="0" Visibility="Collapsed" VerticalAlignment="Center"/>
        <TextBlock x:Name="BannerText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#5E3F0B"/>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" Padding="6">
        <ListBox x:Name="Keys" BorderThickness="0" SelectionChanged="OnSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="4,5">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Key}" FontFamily="Consolas" FontSize="12" Foreground="#486475" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#146662" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,18,18">
          <StackPanel x:Name="DetailPanel">
            <TextBlock x:Name="DetailName" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="DetailKey" FontFamily="Consolas" FontSize="12" Foreground="#486475" Margin="0,2,0,8"/>
            <TextBlock x:Name="DetailDescription" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock x:Name="CurrentLabel" Style="{StaticResource Fact}"/>
              <TextBlock x:Name="CurrentValue" Grid.Column="1" Style="{StaticResource FactValue}" FontFamily="Consolas"/>
              <TextBlock x:Name="ChangedLabel" Grid.Row="1" Style="{StaticResource Fact}"/>
              <TextBlock x:Name="ChangedValue" Grid.Row="1" Grid.Column="1" Style="{StaticResource FactValue}"/>
              <TextBlock x:Name="DefaultLabel" Grid.Row="2" Style="{StaticResource Fact}"/>
              <TextBlock x:Name="DefaultValue" Grid.Row="2" Grid.Column="1" Style="{StaticResource FactValue}" FontFamily="Consolas"/>
              <TextBlock x:Name="EffectLabel" Grid.Row="3" Style="{StaticResource Fact}"/>
              <TextBlock x:Name="EffectValue" Grid.Row="3" Grid.Column="1" Style="{StaticResource FactValue}"/>
            </Grid>

            <StackPanel x:Name="EditArea">
              <DockPanel Margin="0,4,0,6">
                <CheckBox x:Name="JsonSwitch" DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center" Checked="OnJsonSwitch"
                          Unchecked="OnJsonSwitch"/>
                <TextBlock x:Name="EditorLabel" FontWeight="SemiBold"/>
              </DockPanel>
              <StackPanel x:Name="Editors">
                <CheckBox x:Name="ToggleEditor" Visibility="Collapsed" Checked="OnToggle" Unchecked="OnToggle" VerticalContentAlignment="Center"/>
                <TextBox x:Name="ValueEditor" Visibility="Collapsed" Padding="8,4" TextChanged="OnValueText" MaxLength="65536"
                         FontFamily="Consolas"/>

                <StackPanel x:Name="AddressEditor" Visibility="Collapsed">
                  <Grid Margin="0,0,34,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="AddressHeader" FontWeight="SemiBold" FontSize="12" Foreground="#324F5F"/>
                    <TextBlock x:Name="LabelHeader" Grid.Column="2" FontWeight="SemiBold" FontSize="12" Foreground="#324F5F"/>
                  </Grid>
                  <ItemsControl x:Name="AddressRows">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,4">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                          <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Padding="6,3" FontFamily="Consolas" MaxLength="64"
                                   AutomationProperties.LabeledBy="{Binding ElementName=AddressHeader}"/>
                          <TextBox Grid.Column="2" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Padding="6,3" MaxLength="64"
                                   AutomationProperties.LabeledBy="{Binding ElementName=LabelHeader}"/>
                          <Button Grid.Column="3" Content="✕" Margin="6,0,0,0" Click="OnRemoveAddress" Background="Transparent"
                                  BorderThickness="0" Cursor="Hand" AutomationProperties.Name="{Binding RemoveText, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="ListEditor" Visibility="Collapsed">
                  <ItemsControl x:Name="ListRows">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,4">
                          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                          <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Padding="6,3" FontFamily="Consolas" MaxLength="256"
                                   AutomationProperties.LabeledBy="{Binding ElementName=EditorLabel}"/>
                          <Button Grid.Column="1" Content="✕" Margin="6,0,0,0" Click="OnRemoveItem" Background="Transparent"
                                  BorderThickness="0" Cursor="Hand" AutomationProperties.Name="{Binding RemoveText, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <WrapPanel x:Name="RowActions" Visibility="Collapsed" Margin="0,4,0,0">
                  <Button x:Name="AddRowButton" Style="{StaticResource Action}" Click="OnAddRow"/>
                  <Button x:Name="ConnectionButton" Style="{StaticResource Action}" Click="OnAddConnection"/>
                </WrapPanel>
              </StackPanel>
              <TextBlock x:Name="ValidationText" Foreground="#9A2F2F" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"
                         AutomationProperties.LiveSetting="Polite"/>

              <Label x:Name="ReasonLabel" Target="{Binding ElementName=ReasonBox}" Padding="0,14,0,4" FontWeight="SemiBold"/>
              <TextBox x:Name="ReasonBox" Padding="8,4" MaxLength="200" TextChanged="OnReasonText"/>

              <WrapPanel Margin="0,12,0,0">
                <Button x:Name="SaveButton" Style="{StaticResource Action}" Click="OnSave" Background="#145856" Foreground="White"
                        BorderThickness="0" FontWeight="SemiBold" Padding="15,7"/>
                <Button x:Name="ResetButton" Style="{StaticResource Action}" Click="OnReset" Padding="12,7"/>
              </WrapPanel>
            </StackPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource Small}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>

            <TextBlock x:Name="HistoryLabel" FontWeight="SemiBold" Margin="0,18,0,6"/>
            <DataGrid x:Name="HistoryRows" AutoGenerateColumns="False" IsReadOnly="True" CanUserReorderColumns="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E6ECEF"
                      BorderBrush="#CFDCE2" BorderThickness="1" Background="White" RowHeight="30" MaxHeight="260"
                      SelectionMode="Single">
              <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding When}" Width="130" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Binding="{Binding Who}" Width="*" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Binding="{Binding Old}" Width="*" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Binding="{Binding New}" Width="*" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Binding="{Binding Reason}" Width="1.4*" ElementStyle="{StaticResource CellText}"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="HistoryEmpty" Style="{StaticResource Small}" Margin="0,6,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <TextBlock x:Name="Footer" Grid.Row="3" Margin="0,8,0,0" Style="{StaticResource Small}"/>
  </Grid>
</Window>
