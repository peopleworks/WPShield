<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>

    <!--
      WPShield.NetworkFilter is Windows-only because it drives WinDivert. It references only
      WPShield.Abstractions, never the reverse, so the platform-independent projects stay
      buildable and testable on Linux.

      WinDivert is not a package and is not bundled. The operator copies WinDivert.dll and
      WinDivert64.sys from the official 2.2.2 release next to wpshield.exe; the P/Invoke
      declarations resolve the DLL from the assembly directory only. See ADR 0006 and
      docs/en/network-filter-design.md.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../WPShield.Abstractions/WPShield.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WPShield.NetworkFilter.Tests" />
  </ItemGroup>

</Project>
