<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>

    <!--
      WPShield.SecurityMonitor is Windows-only because it reads the Windows Security event
      log (System.Diagnostics.Eventing.Reader), which requires elevation and is not available
      on Linux. It references only WPShield.Abstractions, never the reverse. This keeps the
      platform-independent projects buildable and testable on Linux.

      Reading the Security log requires Administrator privileges. The monitor refuses to
      start if elevation is absent; it never runs in a degraded mode.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../WPShield.Abstractions/WPShield.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <Reference Include="System.Diagnostics.EventLog">
      <HintPath>$(ProgramFiles)\dotnet\packs\Microsoft.AspNetCore.App.Ref\10.0.10\ref\net10.0\System.Diagnostics.EventLog.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
