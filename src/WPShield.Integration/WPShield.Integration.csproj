<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>

    <!--
      WPShield.Integration bridges WPShield.SecurityMonitor and WPShield.NetworkFilter.
      It references both Windows-only projects so operators can wire security event
      findings into the dynamic network block list.

      This project is optional: the core gateway, rules, and sensor projects do not
      depend on it.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../WPShield.SecurityMonitor/WPShield.SecurityMonitor.csproj" />
    <ProjectReference Include="../WPShield.NetworkFilter/WPShield.NetworkFilter.csproj" />
  </ItemGroup>

</Project>
