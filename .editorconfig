root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
dotnet_sort_system_directives_first = true
dotnet_style_require_accessibility_modifiers = always:suggestion

[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2
